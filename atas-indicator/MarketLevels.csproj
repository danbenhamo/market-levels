<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <!-- Folder where ATAS is installed. Change it if ATAS is somewhere else. -->
    <AtasPath Condition="'$(AtasPath)' == ''">C:\Program Files (x86)\ATAS Platform</AtasPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ATAS.Indicators"><HintPath>$(AtasPath)\ATAS.Indicators.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ATAS.DataFeedsCore"><HintPath>$(AtasPath)\ATAS.DataFeedsCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OFT.Attributes"><HintPath>$(AtasPath)\OFT.Attributes.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Utils.Common"><HintPath>$(AtasPath)\Utils.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
